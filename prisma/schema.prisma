
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  REMOTE
}

enum ExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  EXECUTIVE
}

enum ApplicationStatus {
  PENDING_PAYMENT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  REJECTED
  ACCEPTED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  ABSA
  STRIPE
  DEVELOPMENT
}

// ==========================================
// USERS
// ==========================================

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?
  role         Role     @default(JOB_SEEKER)
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobSeeker    JobSeeker?
  employer     Employer?
  payments     Payment[]
  receipts     Receipt[]

  @@index([role])
  @@index([createdAt])
}

// ==========================================
// JOB SEEKER PROFILES
// ==========================================

model JobSeeker {
  id             String   @id @default(cuid())
  userId         String   @unique

  countryId      String?
  cityId         String?

  professionalTitle String?
  biography      String?
  education      String?
  experienceYears Int   @default(0)

  skills         String[]
  resumeUrl      String?
  profileImage   String?
  linkedinUrl    String?
  portfolioUrl   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country        Country? @relation(fields: [countryId], references: [id])
  city           City?    @relation(fields: [cityId], references: [id])

  applications   Application[]

  @@index([countryId])
  @@index([cityId])
}

// ==========================================
// EMPLOYER PROFILES
// ==========================================

model Employer {
  id             String   @id @default(cuid())
  userId         String   @unique

  companyName    String
  companyDescription String?
  website        String?
  companyLogo    String?

  countryId      String?
  cityId         String?

  isApproved     Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country        Country? @relation(fields: [countryId], references: [id])
  city           City?    @relation(fields: [cityId], references: [id])

  jobs           Job[]

  @@index([countryId])
  @@index([cityId])
}

// ==========================================
// COUNTRIES
// ==========================================

model Country {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  currency     String
  currencyName String
  phoneCode    String
  flag         String

  cities       City[]
  jobs         Job[]

  jobSeekers   JobSeeker[]
  employers    Employer[]

  createdAt    DateTime @default(now())
}

// ==========================================
// CITIES
// ==========================================

model City {
  id          String   @id @default(cuid())
  name        String

  countryId   String

  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  jobs        Job[]
  jobSeekers  JobSeeker[]
  employers   Employer[]

  @@unique([name, countryId])
  @@index([countryId])
}

// ==========================================
// JOB CATEGORIES
// ==========================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?

  jobs        Job[]

  createdAt   DateTime @default(now())
}

// ==========================================
// JOB VACANCIES
// ==========================================

model Job {
  id             String   @id @default(cuid())

  title          String
  slug           String   @unique

  companyName    String
  description    String
  requirements   String?
  responsibilities String?

  countryId      String
  cityId         String
  employerId     String?
  categoryId     String

  jobType        JobType
  experienceLevel ExperienceLevel

  salaryLocal    Decimal  @db.Decimal(15, 2)
  salaryCurrency String

  salaryUsd      Decimal  @db.Decimal(15, 2)

  applicationFeeUsd Decimal @db.Decimal(10, 2)

  status         JobStatus @default(DRAFT)

  isFeatured     Boolean  @default(false)
  isRemote       Boolean  @default(false)

  applicationDeadline DateTime?

  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  country        Country  @relation(fields: [countryId], references: [id])
  city           City     @relation(fields: [cityId], references: [id])
  employer       Employer? @relation(fields: [employerId], references: [id])
  category       Category @relation(fields: [categoryId], references: [id])

  applications   Application[]

  @@index([countryId])
  @@index([cityId])
  @@index([categoryId])
  @@index([status])
  @@index([jobType])
  @@index([salaryUsd])
  @@index([createdAt])
}

// ==========================================
// JOB APPLICATIONS
// ==========================================

model Application {
  id             String   @id @default(cuid())

  jobId          String
  jobSeekerId    String

  coverLetter    String?
  resumeUrl      String?

  status         ApplicationStatus @default(PENDING_PAYMENT)

  applicationFeeUsd Decimal @db.Decimal(10, 2)
  paymentVerified Boolean @default(false)

  submittedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobSeeker      JobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)

  payment        Payment?

  @@unique([jobId, jobSeekerId])
  @@index([status])
  @@index([jobId])
  @@index([jobSeekerId])
}

// ==========================================
// PAYMENTS
// ==========================================

model Payment {
  id             String   @id @default(cuid())

  userId         String
  applicationId  String   @unique

  amountUsd      Decimal  @db.Decimal(10, 2)
  amountLocal    Decimal  @db.Decimal(15, 2)
  currency       String

  provider       PaymentProvider
  status         PaymentStatus @default(PENDING)

  transactionId  String?  @unique
  providerReference String?

  paymentUrl     String?

  verifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User        @relation(fields: [userId], references: [id])
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  receipt        Receipt?

  @@index([userId])
  @@index([status])
  @@index([provider])
}

// ==========================================
// PAYMENT RECEIPTS
// ==========================================

model Receipt {
  id             String   @id @default(cuid())

  receiptNumber  String   @unique

  userId         String
  paymentId      String   @unique

  amount         Decimal  @db.Decimal(15, 2)
  currency       String

  issuedAt       DateTime @default(now())

  user           User    @relation(fields: [userId], references: [id])
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// ADMINISTRATOR AUDIT LOGS
// ==========================================

model AuditLog {
  id          String   @id @default(cuid())

  adminId     String
  action      String
  entity      String
  entityId    String?
  details     Json?

  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ==========================================
// REFRESH TOKENS
// ==========================================

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String

  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
